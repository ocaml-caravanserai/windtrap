(executable
 (name suite_main)
 (modules suite_main)
 (libraries windtrap unix))

(cram
 (applies_to :whole_subtree)
 (deps suite_main.exe))

; baselines.t accepts literals in a copy of the suite's source.

(cram
 (applies_to baselines)
 (deps suite_main.ml))

; workers.t corrects literals in a copy of its fixture's source.

(executable
 (name workers_main)
 (modules workers_main)
 (libraries windtrap unix))

(cram
 (applies_to workers)
 (enabled_if
  (<> %{os_type} Win32))
 (deps workers_main.exe workers_main.ml))

; process.t and replaced.t run process_main.exe, whose suites fork, spawn
; domains and start the program again; replaced.t reads /proc/self/exe.
; process.t also runs process_main.bc, which loads windtrap's stubs.

(executable
 (name process_main)
 (modes byte exe)
 (modules process_main)
 (libraries windtrap unix))

(cram
 (applies_to process)
 (package windtrap)
 (enabled_if
  (<> %{os_type} Win32))
 (deps process_main.exe process_main.bc ../../../lib/dllwindtrap_stubs.so))

(cram
 (applies_to replaced)
 (enabled_if
  (= %{system} linux))
 (deps process_main.exe))

(executable
 (name send_signal)
 (modules send_signal)
 (libraries unix))

(cram
 (applies_to signals)
 (enabled_if
  (<> %{os_type} Win32))
 (deps send_signal.exe))

; broadcast.t runs the mutation loop, which forks, over a suite whose one
; module is instrumented in every build.

(library
 (name mutant_subject)
 (modules mutant_subject)
 (preprocess
  (pps ppx_windtrap.mutate)))

(executable
 (name mutant_main)
 (modules mutant_main)
 (libraries windtrap mutant_subject))

(cram
 (package ppx_windtrap)
 (applies_to broadcast)
 (enabled_if
  (<> %{os_type} Win32))
 (deps mutant_main.exe))

; nodune.t reads OCAMLPATH as POSIX spells it and runs the mutation loop.
; Under --instrument-with, dune 3.23.1 and 3.24 close (package windtrap)
; over ppx_windtrap, whose runtime depends on windtrap, and report a
; dependency cycle. The instrumented runs of @self-cover, @self-mutate and
; the release set SKIP_PACKAGE_SESSIONS for that reason, and it skips
; every session that depends on a package.

(cram
 (applies_to nodune)
 (package ppx_windtrap)
 (enabled_if
  (and
   (<> %{os_type} Win32)
   (<> %{env:SKIP_PACKAGE_SESSIONS=} true)))
 (deps
  (package windtrap)
  ../ppx/pp.exe))

; inline.t reads the fixtures' sources, as a run under dune reads the
; build's copy, and writes their corrections beside them.

(cram
 (package ppx_windtrap)
 (applies_to inline)
 (deps
  inline/runner.exe
  inline/undriven.exe
  inline/test_shapes.exe
  inline/scene_runner.exe
  (glob_files inline/*.ml)))
