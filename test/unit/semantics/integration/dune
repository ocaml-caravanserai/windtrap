(library
 (name windtrap_mutate_forced)
 (modules
  aliased
  arid
  attributes
  forced
  logs
  no_guard
  oracle
  own_constructors
  own_unit
  rebound
  recursive
  shadowed)
 (flags
  (:standard -w +a-70 -warn-error +a))
 (preprocess
  (pps ppx_windtrap.mutate)))

; Type-directed disambiguation is warning 40's subject, so this one keeps
; dune's default warning set.

(library
 (name windtrap_mutate_disambiguate)
 (modules codec disambiguate expected_type opened_none)
 (preprocess
  (pps ppx_windtrap.mutate)))

; A [None] of another type in scope, and a GADT match at a site, under
; fatal warnings and -principal.

(library
 (name windtrap_mutate_principal)
 (modules gadt levels numeric opened_levels)
 (flags
  (:standard -principal -w +a-70 -warn-error +a))
 (preprocess
  (pps ppx_windtrap.mutate)))

; Without -strict-sequence, under fatal warnings.

(library
 (name windtrap_mutate_loose)
 (modules loose)
 (flags
  (:standard -no-strict-sequence -w +a-70 -warn-error +a))
 (preprocess
  (pps ppx_windtrap.mutate)))

; The operators of another module under each opaque form of open, under
; fatal warnings and -principal. Warnings 44 and 45 report the opens that
; shadow an identifier, which is the subject of these modules.

(library
 (name windtrap_mutate_scoped)
 (modules float_ops scoped)
 (flags
  (:standard -principal -w +a-44-45-70 -warn-error +a))
 (preprocess
  (pps ppx_windtrap.mutate)))

; The operators of Base under the flag -open Base, which the rewriter does
; not see. Only where Base is installed.

(library
 (name windtrap_mutate_base)
 (enabled_if %{lib-available:base})
 (modules base_ops)
 (libraries base)
 (flags
  (:standard -open Base -w +a-70 -warn-error +a))
 (preprocess
  (pps ppx_windtrap.mutate)))

(test
 (package ppx_windtrap)
 (name test_base_ops)
 (enabled_if %{lib-available:base})
 (build_if %{lib-available:base})
 (modules test_base_ops)
 (libraries windtrap_mutate_base))

; test_registration lists it, calling nothing in it, so that runtest builds
; it at all. It is instrumented only under --instrument-with.

(library
 (name windtrap_mutate_both)
 (modules both)
 (instrumentation
  (backend ppx_windtrap.coverage))
 (instrumentation
  (backend ppx_windtrap.mutate)))

(test
 (package ppx_windtrap)
 (name test_registration)
 (modules test_registration)
 (libraries
  windtrap
  windtrap.runtime
  windtrap_mutate_forced
  windtrap_mutate_disambiguate
  windtrap_mutate_principal
  windtrap_mutate_loose
  windtrap_mutate_scoped
  windtrap_mutate_both))
